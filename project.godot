; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Temiz Sürüm"
run/main_scene="res://scenes/splash_screen.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 1)
config/icon="uid://bubequlir8qvm"

[autoload]

GameManager="*res://scripts/game_manager.gd"
CombatTuning="*res://scripts/combat_tuning.gd"
UISound="*res://scripts/ui_sound.gd"
NetworkManager="*res://scripts/network_manager.gd"

[debug]

file_logging/enable_file_logging=true
file_logging/max_log_files=10

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/YATI/plugin.cfg")

[gui]

theme/custom="res://assets/fonts/theme.tres"

[physics]

2d/run_on_separate_thread=true
