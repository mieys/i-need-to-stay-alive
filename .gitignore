# Godot 4+ specific ignores
.godot/
/android/

# Export edilmiş oyun derlemeleri ve büyük eklenti araçları - kaynak kod
# değiller, GitHub'ın 100MB dosya sınırını aşıyorlar (Co-op.exe/Co-op
# (guncel).exe/zivacode.exe). Godot editöründen "Export" ile her zaman
# yeniden üretilebilirler, git'te tutulmalarına gerek yok.
*.exe

# Antivirüs/dosya kilidi gibi arka plan işlemlerinin addons/ziva_agent
# altında bıraktığı geçici dosyalar (ör. ~libziva_agent...~RF168eef5c.TMP)
# - proje dosyası değil, iki kişi paylaşınca yanlışlıkla commit edilmesin.
~*.TMP
~*.tmp
