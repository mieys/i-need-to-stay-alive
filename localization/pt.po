#: scripts/player.gd:9353
msgid "TEMEL (Arcane Lanet): mana kalkanı harcamaz; yaratıklar arasında %d kez sekip her sekişte saldırı gücünün %%%d'ü kadar hasar verir. (%.0fsn bekleme)"
msgstr "BÁSICA (Maldição arcana): não gasta escudo de mana; ricocheteia %d vezes entre criaturas, causando %d%% do poder de ataque por ricochete. (%.0f s de recarga)"

#: scripts/player.gd:9356
msgid "TEMEL (Don Nova): 0.5sn durup odaklanır, sonra yavaşça yayılan buz dalgası değdiği yaratıkları %.0fsn boyunca %%%d yavaşlatır ve saldırı gücünün %%%d'ü kadar hasar verir. (%.0fsn bekleme)"
msgstr "BÁSICA (Nova de gelo): fique parada e concentre-se por 0.5 s; depois uma onda de gelo que se espalha devagar deixa as criaturas alcançadas mais lentas por %.0f s em %d%% e causa %d%% do poder de ataque. (%.0f s de recarga)"

#: scripts/player.gd:9359
msgid "ULTİ (Hortum): %.0fsn boyunca dolaşan %d hortum çıkarır, her biri değdiği yaratığa saniyede en fazla 1 kez saldırı gücünün %%%d'ü kadar hasar verir. (%.0fsn bekleme)"
msgstr "SUPREMA (Tornado): por %.0f s, %d tornados vagam; cada um causa %d%% do poder de ataque à criatura que toca, no máximo uma vez por segundo. (%.0f s de recarga)"

#: scripts/player.gd:9362
msgid "ULTİ (Meteor Patlaması): %.0fsn odaklanıp (yürüyebilirsin) çevrendeki yaratıkların üstüne saldırı gücünün %%%d'ü kadar hasar veren meteorlar yağdırır. (%.0fsn bekleme)"
msgstr "SUPREMA (Chuva de meteoros): canalize por %.0f s (dá para andar) e faça chover meteoros nas criaturas próximas, cada um causando %d%% do poder de ataque. (%.0f s de recarga)"

#: scripts/player.gd:9374
msgid "TEMEL (Arcane Lanet): %d kez seken büyü, her sekişte saldırı gücünün %%%d'ü kadar hasar."
msgstr "BÁSICA (Maldição arcana): feitiço que ricocheteia %d vezes, %d%% do poder de ataque por ricochete."

#: scripts/player.gd:9377
msgid "TEMEL (Don Nova): buz dalgası %.0fsn %%%d yavaşlatır, saldırı gücünün %%%d'ü kadar hasar verir."
msgstr "BÁSICA (Nova de gelo): onda de gelo que deixa mais lento por %.0f s em %d%% e causa %d%% do poder de ataque."

#: scripts/player.gd:9380
msgid "ULTİ (Hortum): %.0fsn dolaşan %d hortum, değdiğine saldırı gücünün %%%d'ü kadar hasar."
msgstr "SUPREMA (Tornado): por %.0f s, %d tornados vagam, causando %d%% do poder de ataque ao que tocam."

#: scripts/player.gd:9383
msgid "ULTİ (Meteor Patlaması): %.0fsn odaklanıp çevreye saldırı gücünün %%%d'ü kadar hasar veren meteorlar yağdırır."
msgstr "SUPREMA (Chuva de meteoros): canalize por %.0f s e faça chover meteoros ao redor, causando %d%% do poder de ataque."

