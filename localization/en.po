#: scripts/cadi_math.gd:184
msgid "Değen yaratıklar 4 saniye delirir ve en yakınındaki yaratığa saldırır (boss ve elitler etkilenmez)."
msgstr "Creatures it touches go mad for 4 seconds and attack the nearest creature (bosses and elites are immune)."

#: scripts/cadi_math.gd:185
msgid "Değen yaratıkları 2 saniye dondurur ve saldırı gücünün %100'ü kadar hasar verir."
msgstr "Freezes creatures it touches for 2 seconds and deals 100% of attack power."

#: scripts/cadi_math.gd:186
msgid "Patlayarak yok olur ve çevresine saldırı gücünün %200'ü kadar hasar verir."
msgstr "Explodes, dealing 200% of attack power around it."

#: scripts/cadi_math.gd:187
msgid "Üstünde duran müttefikler her saniye saldırı gücünün %20'si kadar can yeniler."
msgstr "Allies standing on it restore 20% of attack power as health every second."

#: scripts/cadi_math.gd:188
msgid "Değen yaratıkları 2 saniye korkutur ve saldırı gücünün %100'ü kadar hasar verir."
msgstr "Terrifies creatures it touches for 2 seconds and deals 100% of attack power."

#: scripts/cadi_math.gd:189
msgid "Üstünde duran müttefikler her saniye saldırı gücünün %25'i kadar mana kalkanı yeniler."
msgstr "Allies standing on it restore 25% of attack power as mana shield every second."

