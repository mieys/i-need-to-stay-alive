msgstr "SPECTATE A FRIEND"

#: scripts/downed_spectate.gd:197
msgid "OK TUŞLARIYLA ARKADAŞINI İZLE"
msgstr "USE THE ARROW KEYS TO SPECTATE A FRIEND"

