#: scripts/deep_forest_lore.gd:19
msgid "IŞIYAN KAYALIKLAR"
msgstr "GLOWING CRAGS"

#: scripts/deep_forest_lore.gd:19
msgid "Kristaller unutulmuş bir şarkıyı mırıldanıyor."
msgstr "The crystals hum a forgotten song."

#: scripts/deep_forest_lore.gd:20
msgid "SİSLİ SAZLIK"
msgstr "MISTY REEDS"

#: scripts/deep_forest_lore.gd:20
msgid "Yaşlı ağaç uyumuyor. Sadece bekliyor."
msgstr "The old tree isn't sleeping. It's only waiting."

#: scripts/deep_forest_lore.gd:23
msgid "KEMİK MAHZENİ"
msgstr "BONE CRYPT"

#: scripts/deep_forest_lore.gd:23
msgid "Mühür çatlamış. Aşağıdan kemik sesleri geliyor... inmeye cesaretin var mı?"
msgstr "The seal is cracked. The rattle of bones rises from below... dare you descend?"

#: scripts/deep_forest_lore.gd:24
msgid "ET KUYUSU"
msgstr "FLESH WELL"

#: scripts/deep_forest_lore.gd:24
msgid "Kuyunun ağzı açık. Derinlerden bir kalp atışı duyuluyor."
msgstr "The well is open. A heartbeat echoes from the depths."

#: scripts/deep_forest_lore.gd:25
msgid "BOYNUZLU KAPI"
msgstr "HORNED GATE"

#: scripts/deep_forest_lore.gd:25
msgid "Kapı aralık. Mavi ışık içeriden birini çağırıyor."
msgstr "The gate is ajar. A blue light calls to someone inside."

#: scripts/deep_forest_lore.gd:78
msgid "Mühürlü."
msgstr "Sealed."

#: scripts/downed_spectate.gd:149
msgid "Kendin"
msgstr "Yourself"

#: scripts/downed_spectate.gd:152
