#: scripts/babaanne_npc.gd:138
msgid "Hoş geldin tatlım!"
msgstr "Добро пожаловать, солнышко!"

#: scripts/babaanne_npc.gd:138
msgid "Ah, sonunda geldin canım!"
msgstr "Ах, наконец-то ты пришёл, дорогой!"

#: scripts/babaanne_npc.gd:138
msgid "Gel bakayım, üşüdün mü?"
msgstr "Иди сюда, замёрз?"

#: scripts/babaanne_npc.gd:138
msgid "Ellerin buz gibi, gel ateşin başına!"
msgstr "Руки ледяные, садись к огню!"

#: scripts/babaanne_npc.gd:139
msgid "Neredeydin? Merak ettim!"
msgstr "Где ты был? Я так волновалась!"

#: scripts/babaanne_npc.gd:139
msgid "Kapıyı ört de içerisi ısınsın."
msgstr "Закрой дверь, чтобы стало тепло."

#: scripts/babaanne_npc.gd:139
msgid "Çizmelerini sil, yeni temizledim!"
msgstr "Вытри сапоги, я только что убрала!"

#: scripts/babaanne_npc.gd:140
msgid "Tam zamanında geldin, çorba kaynıyor."
msgstr "Как раз вовремя, суп кипит."

#: scripts/babaanne_npc.gd:140
msgid "Yüzünü görmek içimi ısıttı."
msgstr "Увижу тебя — и на сердце теплеет."

#: scripts/babaanne_npc.gd:140
msgid "Gel otur, yorgun görünüyorsun."
msgstr "Садись, ты выглядишь усталым."

#: scripts/babaanne_npc.gd:144
msgid "Hoş geldiniz çocuklar!"
msgstr "Добро пожаловать, детки!"

#: scripts/babaanne_npc.gd:144
msgid "Ah, hepiniz geldiniz, ne güzel!"
msgstr "Ах, вы все здесь, как чудесно!"

#: scripts/babaanne_npc.gd:144
msgid "Gelin bakalım, üşüdünüz mü?"
msgstr "Идите сюда, замёрзли?"

#: scripts/babaanne_npc.gd:144
msgid "Ellerinizi ısıtın, ateşin başına gelin!"
msgstr "Погрейте руки, садитесь к огню!"

#: scripts/babaanne_npc.gd:145
msgid "Neredeydiniz? Hepiniz için merak ettim!"
msgstr "Где вы были? Я за всех вас волновалась!"

#: scripts/babaanne_npc.gd:145
msgid "Kapıyı örtün de içerisi ısınsın."
msgstr "Закройте дверь, чтобы стало тепло."

#: scripts/babaanne_npc.gd:145
msgid "Çizmelerinizi silin, yeni temizledim!"
msgstr "Вытрите сапоги, я только что убрала!"

#: scripts/babaanne_npc.gd:146
msgid "Tam zamanında geldiniz, çorba kaynıyor."
msgstr "Как раз вовремя, суп кипит."

#: scripts/babaanne_npc.gd:146
msgid "Hepinizi görmek içimi ısıttı."
msgstr "Увижу вас всех — и на сердце теплеет."

#: scripts/babaanne_npc.gd:146
msgid "Gelin oturun, yorgun görünüyorsunuz."
msgstr "Садитесь, вы все выглядите усталыми."

#: scripts/babaanne_npc.gd:149
msgid "Kendinize iyi bakın çocuklar!"
msgstr "Берегите себя, детки!"

#: scripts/babaanne_npc.gd:149
msgid "Akşama gelin, çorba hazır olur!"
msgstr "Заходите вечером, суп будет готов!"

#: scripts/babaanne_npc.gd:149
msgid "Hava kararmadan dönün!"
msgstr "Возвращайтесь до темноты!"

#: scripts/babaanne_npc.gd:149
msgid "Yolunuz açık olsun!"
msgstr "Счастливого пути!"

#: scripts/babaanne_npc.gd:150
msgid "Atkılarınızı unutmayın!"
msgstr "Не забудьте шарфы!"

#: scripts/babaanne_npc.gd:150
msgid "Erken dönün, merak ederim."
msgstr "Возвращайтесь пораньше, а то я буду волноваться."

#: scripts/babaanne_npc.gd:153
msgid "Al bakalım, sıcak sıcak çorba!"
msgstr "Держи, горячий супчик!"

#: scripts/babaanne_npc.gd:153
msgid "Ye ki gücün yerine gelsin."
msgstr "Ешь, чтобы набраться сил."

#: scripts/babaanne_npc.gd:153
msgid "Bir kâse çorba içmeden bırakmam seni!"
msgstr "Без тарелки супа я тебя не отпущу!"

#: scripts/babaanne_npc.gd:154
msgid "Sebze çorbası, tam sevdiğin gibi."
msgstr "Овощной суп, как ты любишь."

#: scripts/babaanne_npc.gd:154
msgid "Afiyet olsun canım, kuvvet olsun!"
msgstr "Приятного аппетита, дорогой, расти сильным!"

#: scripts/babaanne_npc.gd:154
msgid "Yanına taze ekmek de koydum."
msgstr "И свежего хлебушка рядом положила."

#: scripts/babaanne_npc.gd:155
msgid "Üfle üfle, dilini yakma!"
msgstr "Подуй, не обожги язык!"

#: scripts/babaanne_npc.gd:155
msgid "Annemin tarifi, her derde iyi gelir."
msgstr "Мамин рецепт, от всех хворей."

#: scripts/babaanne_npc.gd:158
msgid "Gençken ben de senin gibi maceracıydım."
msgstr "В молодости я тоже была искательницей приключений, как ты."

#: scripts/babaanne_npc.gd:158
msgid "Deden de hiç yerinde durmazdı, sen ona çekmişsin."
msgstr "Твой дедушка тоже никогда не сидел на месте, ты в него пошёл."

#: scripts/babaanne_npc.gd:159
msgid "Kazan kaynıyor, birazdan çorba hazır."
msgstr "Котёл кипит, скоро суп будет готов."

#: scripts/babaanne_npc.gd:159
msgid "Dışarıda dolaşırken atkını unutma!"
msgstr "Не забудь шарф, когда выходишь!"

#: scripts/babaanne_npc.gd:159
msgid "Bu kemiklerim yağmuru hep önceden bilir."
msgstr "Эти старые кости всегда чуют, когда будет дождь."

#: scripts/babaanne_npc.gd:160
msgid "Sen sağlıklı ol yeter, gerisi kolay."
msgstr "Было бы здоровье, остальное приложится."

#: scripts/babaanne_npc.gd:160
msgid "Akşama erken gel, ateşi yakarım."
msgstr "Приходи сегодня пораньше, я разожгу огонь."

#: scripts/babaanne_npc.gd:160
msgid "Rafların tozunu aldım, bak nasıl parlıyor!"
msgstr "Протёрла полки от пыли, посмотри, как блестят!"

#: scripts/babaanne_npc.gd:161
msgid "Bahçedeki çiçekler bu yıl çok güzel açtı."
msgstr "Цветы в саду в этом году распустились на славу."

#: scripts/babaanne_npc.gd:161
msgid "Kitabımın sonunu merak ediyorum, sakın söyleme!"
msgstr "Умираю, как хочу узнать, чем кончится моя книга, только не вздумай рассказывать!"

#: scripts/babaanne_npc.gd:162
msgid "Bir gün sana örgü örmeyi öğreteceğim."
msgstr "Когда-нибудь научу тебя вязать."

#: scripts/babaanne_npc.gd:162
msgid "Şu sandalye de benim dizlerim gibi gıcırdıyor."
msgstr "Этот стул скрипит прямо как мои колени."

#: scripts/babaanne_npc.gd:163
msgid "Elmalı turta yapmayı düşünüyorum, ne dersin?"
msgstr "Думаю испечь яблочный пирог, что скажешь?"

#: scripts/babaanne_npc.gd:163
msgid "Pencereden kuşları izlemek en sevdiğim şey."
msgstr "Больше всего люблю смотреть на птиц из окна."

#: scripts/babaanne_npc.gd:166
msgid "Aman tatlım, ne bu hâlin? Otur biraz dinlen."
msgstr "Ох, солнышко, на кого ты похож! Садись, отдохни немного."

#: scripts/babaanne_npc.gd:166
msgid "Yaralanmışsın! Gel, bir çorba içmeden çıkma."
msgstr "Ты ранен! Иди сюда, без тарелки супа не уходи."

#: scripts/babaanne_npc.gd:167
msgid "Dizlerin titriyor, bir dakika otur."
msgstr "У тебя колени дрожат, присядь на минутку."

#: scripts/babaanne_npc.gd:167
msgid "Bu kesik kötü görünüyor, hemen sarayım."
msgstr "Порез выглядит плохо, дай я сразу перевяжу."

#: scripts/babaanne_npc.gd:170
msgid "Gece dışarısı tehlikeli, şöminenin yanında otur."
msgstr "Ночью снаружи опасно, садись у камина."

#: scripts/babaanne_npc.gd:170
msgid "Yaratıklar gece azar, dikkat et canım."
msgstr "Ночью существа звереют, будь осторожен, дорогой."

#: scripts/babaanne_npc.gd:171
msgid "Yıldızlar ne güzel bu gece, ama sen yine de içeride kal."
msgstr "Звёзды сегодня чудесные, но лучше оставайся дома."

#: scripts/babaanne_npc.gd:175
msgid "Hı hı hı! Sen de amma şakacısın!"
msgstr "Хи-хи-хи! Ну ты и шутник!"

#: scripts/babaanne_npc.gd:175
msgid "Hmm... bir şey unuttum ama neydi?"
msgstr "Хм... что-то я забыла, но что же?"

#: scripts/babaanne_npc.gd:176
msgid "Ben ne bileyim tatlım, ben yaşlı bir kadınım."
msgstr "Откуда мне знать, солнышко, я старуха."

#: scripts/babaanne_npc.gd:176
msgid "Seni görmek ne güzel!"
msgstr "Как же я рада тебя видеть!"

#: scripts/babaanne_npc.gd:177
msgid "Gençken dansta herkesi geçerdim, hı hı!"
msgstr "В молодости я всех перетанцовывала, хи-хи!"

#: scripts/babaanne_npc.gd:177
msgid "Gözlüğüm nerede... ah, burnumun ucunda!"
msgstr "Где же мои очки... а, на кончике носа!"

#: scripts/babaanne_npc.gd:180
msgid "Zzz..."
msgstr "Zzz..."

#: scripts/babaanne_npc.gd:180
msgid "Hıımm... beş dakika daha..."
msgstr "Хммм... ещё пять минуточек..."

#: scripts/babaanne_npc.gd:180
msgid "Uyandırdın beni... iyi geceler tatlım."
msgstr "Разбудил меня... спокойной ночи, солнышко."

#: scripts/babaanne_npc.gd:180
msgid "Zzz... çorba... Zzz..."
msgstr "Хрр... суп... Хрр..."

#: scripts/babaanne_npc.gd:181
msgid "Mmm... kurabiyeler fırında... Zzz..."
msgstr "Ммм... печенье в духовке... Хрр..."

#: scripts/babaanne_npc.gd:181
msgid "Zzz... kim o... ah, sensin..."
msgstr "Хрр... кто там... а, это ты..."

#: scripts/babaanne_npc.gd:184
msgid "Daha az önce yedin, birazdan yine pişiririm."
msgstr "Ты только что поел, приготовлю снова чуть позже."

#: scripts/babaanne_npc.gd:184
msgid "Karnın tok mu? Peki, akşama yine yaparım."
msgstr "Уже наелся? Ладно, вечером сварю ещё."

#: scripts/babaanne_npc.gd:185
msgid "Bu kadar çabuk acıktın mı? Biraz bekle, kazan doluyor."
msgstr "Уже проголодался? Подожди немного, котёл наполняется."

#: scripts/babaanne_npc.gd:188
msgid "Kendine iyi bak tatlım!"
msgstr "Береги себя, солнышко!"

#: scripts/babaanne_npc.gd:188
msgid "Akşama gel, çorba hazır olur!"
msgstr "Заходи вечером, суп будет готов!"

#: scripts/babaanne_npc.gd:188
msgid "Hava kararmadan dön!"
msgstr "Возвращайся до темноты!"

#: scripts/babaanne_npc.gd:188
msgid "Yolun açık olsun canım!"
msgstr "Счастливого пути, дорогой!"

#: scripts/babaanne_npc.gd:189
msgid "Atkını unutma!"
msgstr "Не забудь шарф!"

#: scripts/babaanne_npc.gd:189
msgid "Erken dön, merak ederim."
msgstr "Возвращайся пораньше, а то я буду волноваться."

#: scripts/babaanne_npc.gd:192
msgid "Biraz daha tuz mu koysam?"
msgstr "Может, ещё щепотку соли?"

#: scripts/babaanne_npc.gd:192
msgid "Mmm, tam kıvamında!"
msgstr "Ммм, в самый раз!"

#: scripts/babaanne_npc.gd:192
msgid "Kokusu her yeri sardı!"
msgstr "Запах на весь дом!"

#: scripts/babaanne_npc.gd:192
msgid "Bir tutam kekik iyi gider..."
msgstr "Щепотка тимьяна не помешала бы..."

#: scripts/babaanne_npc.gd:193
msgid "Kaynasın bakalım, acele yok."
msgstr "Пусть томится, спешить некуда."

#: scripts/babaanne_npc.gd:193
msgid "Şu havuçlar da ne iri olmuş!"
msgstr "Посмотри, какая морковь выросла!"

#: scripts/babaanne_npc.gd:195
msgid "Şu tozlar da hiç bitmez!"
msgstr "Эта пыль никогда не кончается!"

#: scripts/babaanne_npc.gd:195
msgid "Her yer pırıl pırıl olsun."
msgstr "Всё чисто и блестит."

#: scripts/babaanne_npc.gd:195
msgid "Örümcek, burası senin evin değil!"
msgstr "Паук, это не твой дом!"

#: scripts/babaanne_npc.gd:196
msgid "Bir de raflara bakalım..."
msgstr "Посмотрим и на полках..."

#: scripts/babaanne_npc.gd:197
msgid "Ne güzel kitap bu..."
msgstr "Какая славная книга..."

#: scripts/babaanne_npc.gd:197
msgid "Hmm, bu kısmı okumuştum galiba."
msgstr "Хм, кажется, это место я уже читала."

#: scripts/babaanne_npc.gd:197
msgid "Ah, sonunda kavuştular!"
msgstr "Ах, наконец-то все вместе!"

#: scripts/babaanne_npc.gd:198
msgid "Gözlüğümü silmem lazım..."
msgstr "Надо протереть очки..."

#: scripts/babaanne_npc.gd:202
msgid "Şükürler olsun, sağsın!"
msgstr "Слава богу, ты жив!"

#: scripts/babaanne_npc.gd:202
msgid "Geldin mi canım? Dışarısı savaş alanı..."
msgstr "Вернулся, дорогой? Там снаружи настоящее поле боя..."

#: scripts/babaanne_npc.gd:202
msgid "Çabuk içeri, kapıyı ört! Canavarlar çok yakın."
msgstr "Быстрее внутрь, закрой дверь! Чудовища совсем близко."

#: scripts/babaanne_npc.gd:203
msgid "Yüzün gözün toz içinde! Kaç canavar devirdin?"
msgstr "Ты весь в пыли! Сколько чудовищ ты одолел?"

#: scripts/babaanne_npc.gd:203
msgid "Seni bekliyordum, yüreğim ağzımdaydı!"
msgstr "Я ждала тебя, сердце в пятки ушло!"

#: scripts/babaanne_npc.gd:203
msgid "Yaralandın mı? Göster bakayım!"
msgstr "Ты ранен? Дай посмотрю!"

#: scripts/babaanne_npc.gd:204
msgid "Sesleri duydum, çok korktum senin için."
msgstr "Я слышала шум, так за тебя боялась."

#: scripts/babaanne_npc.gd:204
msgid "Gel, biraz soluklan. Ama çok oyalanma!"
msgstr "Иди, отдышись. Но не задерживайся!"

#: scripts/babaanne_npc.gd:204
msgid "Kahramanım geldi! Dışarısı nasıl?"
msgstr "Мой герой вернулся! Как там снаружи?"

#: scripts/babaanne_npc.gd:205
msgid "Kapıyı sıkıca kapat, kokumuzu almasınlar."
msgstr "Плотно закрой дверь, чтобы они не учуяли наш запах."

#: scripts/babaanne_npc.gd:208
msgid "Şükürler olsun, hepiniz sağsınız!"
msgstr "Слава богу, вы все живы!"

#: scripts/babaanne_npc.gd:208
msgid "Geldiniz mi çocuklar? Dışarısı savaş alanı..."
msgstr "Вернулись, детки? Там снаружи настоящее поле боя..."

#: scripts/babaanne_npc.gd:208
msgid "Çabuk içeri, kapıyı örtün! Canavarlar çok yakın."
msgstr "Быстрее внутрь, закройте дверь! Чудовища совсем близко."

#: scripts/babaanne_npc.gd:209
msgid "Yüzünüz gözünüz toz içinde! Kaç canavar devirdiniz?"
msgstr "Вы все в пыли! Сколько чудовищ вы одолели?"

#: scripts/babaanne_npc.gd:209
msgid "Sizi bekliyordum, yüreğim ağzımdaydı!"
msgstr "Я вас ждала, сердце в пятки ушло!"

#: scripts/babaanne_npc.gd:209
msgid "Yaralanan var mı? Gösterin bakayım!"
msgstr "Кто-нибудь ранен? Дайте посмотрю!"

#: scripts/babaanne_npc.gd:210
msgid "Sesleri duydum, hepiniz için çok korktum."
msgstr "Я слышала шум, так за всех вас боялась."

#: scripts/babaanne_npc.gd:210
msgid "Gelin, biraz soluklanın. Ama çok oyalanmayın!"
msgstr "Идите, отдышитесь. Но не задерживайтесь!"

#: scripts/babaanne_npc.gd:210
msgid "Kahramanlarım geldi! Dışarısı nasıl?"
msgstr "Мои герои вернулись! Как там снаружи?"

#: scripts/babaanne_npc.gd:211
msgid "Kapıyı sıkıca kapatın, kokumuzu almasınlar."
msgstr "Плотно закройте дверь, чтобы они не учуяли наш запах."

#: scripts/babaanne_npc.gd:214
msgid "Şansınız bol olsun çocuklar!"
msgstr "Удачи, детки!"

#: scripts/babaanne_npc.gd:214
msgid "Sağ salim dönün, söz verin bana!"
msgstr "Возвращайтесь целыми и невредимыми, обещайте!"

#: scripts/babaanne_npc.gd:214
msgid "Gösterin onlara gününü!"
msgstr "Покажите им, на что вы способны!"

#: scripts/babaanne_npc.gd:214
msgid "Dikkat edin, birbirinizin arkasını kollayın!"
msgstr "Будьте осторожны, прикрывайте друг друга!"

#: scripts/babaanne_npc.gd:215
msgid "Cesur olun ama dikkatsiz olmayın!"
msgstr "Будьте смелыми, но не безрассудными!"

#: scripts/babaanne_npc.gd:215
msgid "Ateşi yanık tutacağım, dönün bana!"
msgstr "Я буду поддерживать огонь, возвращайтесь ко мне!"

#: scripts/babaanne_npc.gd:218
msgid "Al şu çorbayı, savaşta güç lazım!"
msgstr "Возьмите супа, снаружи вам понадобятся силы!"

#: scripts/babaanne_npc.gd:218
msgid "Ye ki o canavarlara gününü göster!"
msgstr "Поешьте, а потом покажите этим чудовищам, на что вы способны!"

#: scripts/babaanne_npc.gd:218
msgid "Sıcak sıcak iç, yaraların çabuk kapansın."
msgstr "Пейте горячим, так раны быстрее заживут."

#: scripts/babaanne_npc.gd:219
msgid "Aç karnına savaşılmaz, ye hadi!"
msgstr "На голодный желудок не воюют, ешьте!"

#: scripts/babaanne_npc.gd:219
msgid "Bu çorba ölüyü diriltir, iç bakalım!"
msgstr "Этот суп и мёртвого поднимет, пейте!"

#: scripts/babaanne_npc.gd:222
msgid "Bu canavarlar da nereden çıktı böyle, anlamadım gitti."
msgstr "Откуда взялось столько чудовищ? Не понимаю."

#: scripts/babaanne_npc.gd:222
msgid "Deden de bir zamanlar bu adayı savunmuştu."
msgstr "Твой дедушка тоже когда-то защищал этот остров."

#: scripts/babaanne_npc.gd:223
msgid "Evde fazla oyalanma, canavarlar kokumuzu alır."
msgstr "Не засиживайтесь дома, чудовища учуют наш запах."

#: scripts/babaanne_npc.gd:223
msgid "Sen savaş, ben çorbayı sıcak tutarım."
msgstr "Вы сражайтесь, а я буду держать суп горячим."

#: scripts/babaanne_npc.gd:224
msgid "Ben savaşamam ama kalbim hep seninle."
msgstr "Сражаться я не могу, но сердцем всегда с вами."

#: scripts/babaanne_npc.gd:224
msgid "Kıyıdan gelen o sesler... bu gece uyku yok bana."
msgstr "Этот шум с берега... сегодня мне не уснуть."

#: scripts/babaanne_npc.gd:225
msgid "Gücün tükenirse buraya gel, ama uzun kalma!"
msgstr "Заходите, если выбились из сил, но долго не сидите!"

#: scripts/babaanne_npc.gd:225
msgid "Bu ada bizim, kimseye bırakmayız!"
msgstr "Этот остров наш, мы его не отдадим!"

#: scripts/babaanne_npc.gd:226
msgid "Duvarlar yaşlı ama sağlamdır, yine de güvenme."
msgstr "Стены старые, но крепкие; и всё же не полагайтесь на них."

#: scripts/babaanne_npc.gd:226
msgid "Yaralarını sarmak için temiz bez ayırdım."
msgstr "Я отложила чистую ткань, чтобы перевязать ваши раны."

#: scripts/babaanne_npc.gd:227
msgid "Gece boyu ateşi söndürmeyeceğim, yolunu bulasın diye."
msgstr "Я буду жечь огонь всю ночь, чтобы вы нашли дорогу."

#: scripts/babaanne_npc.gd:227
msgid "Korkmak ayıp değil, korkuya rağmen yürümek cesarettir."
msgstr "Бояться не стыдно; идти вперёд несмотря на страх — вот смелость."

#: scripts/babaanne_npc.gd:228
msgid "Biri kapıya vurursa önce sesine bakarım, merak etme."
msgstr "Если кто постучит, сначала проверю голос, не волнуйтесь."

#: scripts/babaanne_npc.gd:228
msgid "Canavarların gözleri karanlıkta parlıyormuş, dikkat et."
msgstr "Говорят, глаза чудовищ светятся в темноте, осторожнее."

#: scripts/babaanne_npc.gd:231
msgid "Gece canavarlar daha da azar, gözünü dört aç."
msgstr "Ночью чудовища злее, смотрите в оба."

#: scripts/babaanne_npc.gd:231
msgid "Karanlıkta yalnız dolaşma, yanında biri olsun."
msgstr "Не бродите в темноте поодиночке, берите кого-нибудь с собой."

#: scripts/babaanne_npc.gd:232
msgid "Fenerini al, karanlık onların tarafında."
msgstr "Возьмите фонарь, темнота на их стороне."

#: scripts/babaanne_npc.gd:235
msgid "Ben gençken bir ayıyı tavayla kovaladım, hı hı!"
msgstr "В молодости я прогнала медведя сковородкой, хи-хи!"

#: scripts/babaanne_npc.gd:235
msgid "Hmm... canavarlar acaba çorba sever mi?"
msgstr "Хм... интересно, чудовища любят суп?"

#: scripts/babaanne_npc.gd:236
msgid "Ne yapayım, ben yaşlı bir kadınım."
msgstr "Что я могу, я ведь старуха."

#: scripts/babaanne_npc.gd:236
msgid "Sağ salim döndün ya, gerisi boş!"
msgstr "Ты вернулся цел и невредим, это главное!"

#: scripts/babaanne_npc.gd:237
msgid "Bir canavar daha görürsem şemsiyemle döverim, hı hı!"
msgstr "Увижу ещё одно чудовище — отлуплю зонтиком, хи-хи!"

#: scripts/babaanne_npc.gd:237
msgid "Kaç taneydiler? Saymayı unuttum..."
msgstr "Сколько их было? Я сбилась со счёта..."

#: scripts/babaanne_npc.gd:240
msgid "Şansın bol olsun canım!"
msgstr "Удачи, дорогой!"

#: scripts/babaanne_npc.gd:240
msgid "Sağ salim dön, söz ver bana!"
msgstr "Возвращайся целым и невредимым, обещай!"

#: scripts/babaanne_npc.gd:240
msgid "Göster onlara gününü!"
msgstr "Покажи им, на что ты способен!"

#: scripts/babaanne_npc.gd:240
msgid "Dikkat et, arkanı kolla!"
msgstr "Будь осторожен, береги спину!"

#: scripts/babaanne_npc.gd:241
msgid "Cesur ol ama dikkatsiz olma!"
msgstr "Будь смелым, но не безрассудным!"

#: scripts/babaanne_npc.gd:241
msgid "Ateşi yanık tutacağım, dön bana!"
msgstr "Я буду поддерживать огонь, возвращайся ко мне!"

#: scripts/babaanne_npc.gd:244
msgid "Savaşanlara sıcak çorba lazım..."
msgstr "Бойцам нужен горячий суп..."

#: scripts/babaanne_npc.gd:244
msgid "Elim titriyor ama çorba yanmasın."
msgstr "Руки дрожат, но суп не должен подгореть."

#: scripts/babaanne_npc.gd:244
msgid "Kepçeyi sıkı tut, korkma!"
msgstr "Крепче держи половник, не бойся!"

#: scripts/babaanne_npc.gd:245
msgid "Kazan dolu olsun, kim gelirse doysun."
msgstr "Пусть котёл будет полным, чтобы каждый, кто придёт, поел."

#: scripts/babaanne_npc.gd:245
msgid "Aç kalan kahraman olmaz..."
msgstr "Ни один герой не побеждал на пустой желудок..."

#: scripts/babaanne_npc.gd:249
msgid "Duyuyor musun? Duvarlara vuruyorlar!"
msgstr "Слышишь? Они колотят по стенам!"

#: scripts/babaanne_npc.gd:249
msgid "Bu ev çok dayanmaz, çık savaş!"
msgstr "Этот дом долго не продержится, выходи сражаться!"

#: scripts/babaanne_npc.gd:249
msgid "Aman tavan! Tavan çöküyor!"
msgstr "Потолок! Потолок рушится!"

#: scripts/babaanne_npc.gd:250
msgid "Canavarlar kapıya dayandı!"
msgstr "Чудовища у двери!"

#: scripts/babaanne_npc.gd:250
msgid "Burada saklanarak kurtulamayız tatlım!"
msgstr "Прячась здесь, мы не выживем, солнышко!"

#: scripts/babaanne_npc.gd:250
msgid "Duvarlar çatlıyor, aman Tanrım!"
msgstr "Стены трескаются, батюшки!"

#: scripts/babaanne_npc.gd:251
msgid "Kapı daha ne kadar dayanır bilmiyorum!"
msgstr "Не знаю, сколько ещё продержится дверь!"

#: scripts/babaanne_npc.gd:251
msgid "Çık şunları kovala, yoksa içeri girecekler!"
msgstr "Идите прогоните их, а то они ворвутся!"

#: scripts/babaanne_npc.gd:252
msgid "Tozlar başıma yağıyor... çabuk ol!"
msgstr "Пыль сыплется на голову... скорее!"

#: scripts/babaanne_npc.gd:252
msgid "Bu evi dedenle birlikte yaptık, yıkılmasın!"
msgstr "Мы с твоим дедушкой построили этот дом, не дай ему рухнуть!"

#: scripts/babaanne_npc.gd:254
msgid "Aman Tanrım! Deprem mi bu?!"
msgstr "Батюшки! Это землетрясение?!"

#: scripts/babaanne_npc.gd:254
msgid "Yer sallanıyor! Bir yere tutunun!"
msgstr "Земля трясётся! Держитесь за что-нибудь!"

#: scripts/babaanne_npc.gd:254
msgid "Bu ses de ne?! Herkes iyi mi?"
msgstr "Что это был за шум?! Все целы?"

#: scripts/babaanne_npc.gd:256
msgid "Canavarlar! Adaya canavarlar saldırıyor!"
msgstr "Чудовища! Чудовища нападают на остров!"

#: scripts/babaanne_npc.gd:256
msgid "Kıyıda gölgeler var... canavarlar geliyor!"
msgstr "На берегу тени... идут чудовища!"

#: scripts/babaanne_npc.gd:256
msgid "Aman Tanrım, sahil canavar dolu!"
msgstr "Батюшки, весь берег в чудовищах!"

#: scripts/babaanne_npc.gd:259
msgid "Hadi çocuklar, çıkın savaşın! Ben evi beklerim."
msgstr "Ну же, детки, выходите сражаться! Я пригляжу за домом."

#: scripts/babaanne_npc.gd:259
msgid "Silahlarınızı alın, adamızı koruyun!"
msgstr "Берите оружие, защищайте наш остров!"

#: scripts/babaanne_npc.gd:260
msgid "Gidin hadi! Ben burada ateşi yanık tutarım."
msgstr "Вперёд! Я буду поддерживать огонь здесь."

#: scripts/babaanne_npc.gd:263
msgid "Evim... yıkıldı mı yoksa?"
msgstr "Мой дом... его больше нет?"

#: scripts/babaanne_npc.gd:263
msgid "Ben savaşamam, yanımdan ayrılmayın!"
msgstr "Я не могу сражаться, не отходи от меня!"

#: scripts/babaanne_npc.gd:263
msgid "Şu canavarlar evimi yerle bir etti!"
msgstr "Эти чудовища разрушили мой дом!"

#: scripts/babaanne_npc.gd:264
msgid "Duvarlar onarılana kadar burada beklerim."
msgstr "Подожду здесь, пока не починят стены."

#: scripts/babaanne_npc.gd:264
msgid "Bu yaşta kapı önünde kaldım, ne günlere kaldık!"
msgstr "Остаться без крыши в моём возрасте, ну и времена!"

#: scripts/babaanne_npc.gd:264
msgid "Elimde süpürge bile yok..."
msgstr "У меня даже метлы нет..."

#: scripts/babaanne_npc.gd:266
msgid "İmdat! Çocuklar, yetişin!"
msgstr "Помогите! Детки, скорее!"

#: scripts/babaanne_npc.gd:266
msgid "Uzak dur benden, yaratık!"
msgstr "Прочь от меня, тварь!"

#: scripts/babaanne_npc.gd:266
msgid "Yardım edin!"
msgstr "Помогите!"

#: scripts/babaanne_npc.gd:266
msgid "Kurtarın beni!"
msgstr "Спасите!"

#: scripts/babaanne_npc.gd:267
msgid "Hayır, hayır, gelme!"
msgstr "Нет, нет, уходи!"

#: scripts/babaanne_npc.gd:268
msgid "Ahh!"
msgstr "Ahh!"

#: scripts/babaanne_npc.gd:268
msgid "Aman!"
msgstr "Ох, батюшки!"

#: scripts/babaanne_npc.gd:268
msgid "Of belim!"
msgstr "Ох, моя спина!"

#: scripts/babaanne_npc.gd:268
msgid "Ay!"
msgstr "Ай!"

#: scripts/babaanne_npc.gd:268
msgid "Acıyor!"
msgstr "Ой, больно!"

#: scripts/babaanne_npc.gd:269
msgid "Of... nefesim kesildi!"
msgstr "Ох... дыхание сбилось!"

#: scripts/babaanne_npc.gd:269
msgid "Bu yaşta koşulur mu..."
msgstr "Бегать в моём возрасте..."

#: scripts/babaanne_npc.gd:269
msgid "Dizlerim... az dur!"
msgstr "Колени мои... держитесь!"

#: scripts/babaanne_npc.gd:269
msgid "Biraz... soluklanayım..."
msgstr "Дайте... отдышаться..."

#: scripts/babaanne_npc.gd:270
msgid "Ah... çocuklarım..."
msgstr "Ох... детки мои..."

#: scripts/babaanne_npc.gd:270
msgid "Ateşi... yanık tutun..."
msgstr "Держите... огонь... горящим..."

#: scripts/babaanne_npc.gd:271
msgid "Evime dönüyorum, çorbayı ısıtayım!"
msgstr "Пойду домой разогревать суп!"

#: scripts/babaanne_npc.gd:271
msgid "Ah evim, güzel evim!"
msgstr "Ах, дом, милый дом!"

#: scripts/babaanne_npc.gd:271
msgid "Duvarlar sağlam mı? Bir bakayım."
msgstr "Стены крепкие? Дай-ка проверю."

