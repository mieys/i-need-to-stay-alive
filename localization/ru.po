msgstr "БАГРОВАЯ ТОПЬ"

#: scripts/deep_forest_lore.gd:17
msgid "Toprak nefes alıyor. Bir şey seni izliyor..."
msgstr "Земля дышит. Что-то следит за тобой..."

#: scripts/deep_forest_lore.gd:18
msgid "IŞIYAN KAYALIKLAR"
msgstr "СИЯЮЩИЕ СКАЛЫ"

#: scripts/deep_forest_lore.gd:18
msgid "Kristaller unutulmuş bir şarkıyı mırıldanıyor."
msgstr "Кристаллы напевают забытую песню."

#: scripts/deep_forest_lore.gd:19
msgid "SİSLİ SAZLIK"
msgstr "ТУМАННЫЕ КАМЫШИ"

#: scripts/deep_forest_lore.gd:19
msgid "Yaşlı ağaç uyumuyor. Sadece bekliyor."
msgstr "Старое дерево не спит. Оно просто ждёт."

#: scripts/deep_forest_lore.gd:22
msgid "Kemik Mahzeni"
msgstr "Костяной склеп"

#: scripts/deep_forest_lore.gd:22
msgid "KEMİK MAHZENİ"
msgstr "КОСТЯНОЙ СКЛЕП"

#: scripts/deep_forest_lore.gd:22
msgid "Mühür çatlamış. Aşağıdan kemik sesleri geliyor... inmeye cesaretin var mı?"
msgstr "Печать треснула. Снизу доносится стук костей... осмелишься спуститься?"

#: scripts/deep_forest_lore.gd:23
msgid "Et Kuyusu"
msgstr "Колодец плоти"

#: scripts/deep_forest_lore.gd:23
