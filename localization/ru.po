#: scripts/deep_forest_lore.gd:16
msgid "Burada ağaçlar ölü doğar; ruhlar yolunu kaybetmiş."
msgstr "Здесь деревья рождаются мёртвыми; духи сбились с пути."

#: scripts/deep_forest_lore.gd:17
