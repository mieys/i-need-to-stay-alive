msgid "Bombardıman alanındaki yaratıklar %50 yavaşlar."
msgstr "轰炸区域内的生物减速 50%。"

#: scripts/skill_evolutions.gd:208
msgid "Seyyar Bombardıman"
msgstr "移动轰炸"

#: scripts/skill_evolutions.gd:208
