msgstr "技能生效期间获得 20% 法力护盾吸收（可以突破吸收上限）。"

#: scripts/skill_evolutions.gd:216
msgid "Güçlü Yenilenme"
msgstr "强力恢复"

#: scripts/skill_evolutions.gd:216
msgid "Yeteneğin yenilediği mana kalkanı %25 artar."
msgstr "技能恢复的法力护盾 +25%。"

#: scripts/skill_evolutions.gd:217
msgid "Uzun Nöbet"
msgstr "持久守望"

#: scripts/skill_evolutions.gd:217
msgid "Yeteneğin etki süresi 2 saniye artar."
msgstr "技能持续时间延长 2 秒。"

#: scripts/skill_evolutions.gd:218
msgid "Anında Kalkan"
msgstr "瞬间护盾"

#: scripts/skill_evolutions.gd:218
msgid "Kullandığında anında maksimum mana kalkanının %15'i kadar mana kalkanı yenilersin."
msgstr "使用时立即恢复 15% 最大法力护盾。"

#: scripts/skill_evolutions.gd:221
msgid "Çabuk Bariyer"
msgstr "快速屏障"

#: scripts/skill_evolutions.gd:221
msgid "Koruma Bariyeri'nin bekleme süresi %25 azalır."
msgstr "守护屏障冷却 -25%。"

#: scripts/skill_evolutions.gd:222
msgid "Büyük Fedakarlık"
msgstr "伟大牺牲"

#: scripts/skill_evolutions.gd:222
msgid "Dostların aldığı hasarı emme oranı %50'ye çıkar."
msgstr "你吸收的友方伤害比例提高到 50%。"

#: scripts/skill_evolutions.gd:223
