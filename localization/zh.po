msgid "Hızlı Dolum"
msgstr "快速装填"

#: scripts/skill_evolutions.gd:200
msgid "Bomba yüklerinin yenilenme hızı %25 artar."
msgstr "炸弹充能恢复速度提高 25%。"

#: scripts/skill_evolutions.gd:201
msgid "Kuvvetli Barut"
msgstr "强效火药"

#: scripts/skill_evolutions.gd:201
msgid "Bomba hasarı artar (saldırı gücü oranı +%20)."
msgstr "炸弹伤害提高（攻击力系数 +20%）。"

