msgstr "坚实姿态"

#: scripts/skill_evolutions.gd:223
msgid "Yetenek aktifken aldığın tüm hasar %25 azalır (emdiğin hasar da bu azaltmadan sonra hesaplanır)."
msgstr "技能生效期间受到所有来源的伤害降低 25%（吸收的伤害也会降低）。"

#: scripts/skill_evolutions.gd:224
msgid "Koruyucu Adım"
msgstr "守护步伐"

#: scripts/skill_evolutions.gd:224
msgid "Yetenek aktifken hareket hızın %20 artar."
msgstr "技能生效期间移动速度 +20%。"

#: scripts/skill_evolutions.gd:225
msgid "İntikam Patlaması"
msgstr "复仇爆发"

#: scripts/skill_evolutions.gd:225
msgid "Yetenek aktifken aldığın tüm hasar birikir; yetenek bitince patlayarak çevrendeki yaratıklara verilir."
msgstr "技能生效期间受到的所有伤害会累积起来，结束时对附近生物爆发。"

#: scripts/skill_evolutions.gd:228
