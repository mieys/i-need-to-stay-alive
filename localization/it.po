#: scripts/skill_evolutions.gd:344
msgid "Kemik Fedası"
msgstr "Sacrificio d'ossa"

#: scripts/skill_evolutions.gd:344
msgid "Canın %20'nin altına düştüğünde anında tüm iskeletlerin ruhunu tüketirsin; hayatta olan her iskelet başına saldırı gücünün %10'u kadar can ve mana kalkanı yenilersin."
msgstr "Quando la salute scende sotto il 20% consumi all'istante le anime di tutti i tuoi scheletri, ripristinando salute e scudo di mana pari al 10% della potenza d'attacco per ogni scheletro vivo."

#: scripts/skill_evolutions.gd:347
msgid "Ucuz Golem"
msgstr "Golem economico"

#: scripts/skill_evolutions.gd:347
