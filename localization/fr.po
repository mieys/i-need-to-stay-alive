#: scripts/babaanne_npc.gd:138
msgid "Hoş geldin tatlım!"
msgstr "Bienvenue, mon chou !"

#: scripts/babaanne_npc.gd:138
msgid "Ah, sonunda geldin canım!"
msgstr "Ah, te voilà enfin, mon chéri !"

#: scripts/babaanne_npc.gd:138
msgid "Gel bakayım, üşüdün mü?"
msgstr "Viens là, tu as froid ?"

#: scripts/babaanne_npc.gd:138
msgid "Ellerin buz gibi, gel ateşin başına!"
msgstr "Tes mains sont glacées, viens t'asseoir près du feu !"

#: scripts/babaanne_npc.gd:139
msgid "Neredeydin? Merak ettim!"
msgstr "Où étais-tu ? Je m'inquiétais !"

#: scripts/babaanne_npc.gd:139
msgid "Kapıyı ört de içerisi ısınsın."
msgstr "Ferme la porte, qu'il fasse chaud ici."

#: scripts/babaanne_npc.gd:139
msgid "Çizmelerini sil, yeni temizledim!"
msgstr "Essuie tes bottes, je viens de faire le ménage !"

#: scripts/babaanne_npc.gd:140
msgid "Tam zamanında geldin, çorba kaynıyor."
msgstr "Pile à l'heure, la soupe bout."

#: scripts/babaanne_npc.gd:140
msgid "Yüzünü görmek içimi ısıttı."
msgstr "Voir ton visage me réchauffe le cœur."

#: scripts/babaanne_npc.gd:140
msgid "Gel otur, yorgun görünüyorsun."
msgstr "Viens t'asseoir, tu as l'air fatigué."

#: scripts/babaanne_npc.gd:144
msgid "Hoş geldiniz çocuklar!"
msgstr "Bienvenue, les enfants !"

#: scripts/babaanne_npc.gd:144
msgid "Ah, hepiniz geldiniz, ne güzel!"
msgstr "Ah, vous êtes tous là, quel bonheur !"

#: scripts/babaanne_npc.gd:144
msgid "Gelin bakalım, üşüdünüz mü?"
msgstr "Venez là, vous avez froid ?"

#: scripts/babaanne_npc.gd:144
msgid "Ellerinizi ısıtın, ateşin başına gelin!"
msgstr "Réchauffez-vous les mains, venez près du feu !"

#: scripts/babaanne_npc.gd:145
msgid "Neredeydiniz? Hepiniz için merak ettim!"
msgstr "Où étiez-vous ? Je m'inquiétais pour vous tous !"

#: scripts/babaanne_npc.gd:145
msgid "Kapıyı örtün de içerisi ısınsın."
msgstr "Fermez la porte, qu'il fasse chaud ici."

#: scripts/babaanne_npc.gd:145
msgid "Çizmelerinizi silin, yeni temizledim!"
msgstr "Essuyez vos bottes, je viens de faire le ménage !"

#: scripts/babaanne_npc.gd:146
msgid "Tam zamanında geldiniz, çorba kaynıyor."
msgstr "Pile à l'heure, la soupe bout."

#: scripts/babaanne_npc.gd:146
msgid "Hepinizi görmek içimi ısıttı."
msgstr "Vous voir tous me réchauffe le cœur."

#: scripts/babaanne_npc.gd:146
msgid "Gelin oturun, yorgun görünüyorsunuz."
msgstr "Venez vous asseoir, vous avez l'air fatigués."

#: scripts/babaanne_npc.gd:149
msgid "Kendinize iyi bakın çocuklar!"
msgstr "Prenez soin de vous, les enfants !"

#: scripts/babaanne_npc.gd:149
msgid "Akşama gelin, çorba hazır olur!"
msgstr "Passez ce soir, la soupe sera prête !"

#: scripts/babaanne_npc.gd:149
msgid "Hava kararmadan dönün!"
msgstr "Rentrez avant la nuit !"

#: scripts/babaanne_npc.gd:149
msgid "Yolunuz açık olsun!"
msgstr "Bon voyage !"

#: scripts/babaanne_npc.gd:150
msgid "Atkılarınızı unutmayın!"
msgstr "N'oubliez pas vos écharpes !"

#: scripts/babaanne_npc.gd:150
msgid "Erken dönün, merak ederim."
msgstr "Rentrez tôt, sinon je m'inquiète."

#: scripts/babaanne_npc.gd:153
msgid "Al bakalım, sıcak sıcak çorba!"
msgstr "Tiens, une soupe bien chaude !"

#: scripts/babaanne_npc.gd:153
msgid "Ye ki gücün yerine gelsin."
msgstr "Mange pour reprendre des forces."

#: scripts/babaanne_npc.gd:153
msgid "Bir kâse çorba içmeden bırakmam seni!"
msgstr "Je ne te laisse pas partir sans un bol de soupe !"

#: scripts/babaanne_npc.gd:154
msgid "Sebze çorbası, tam sevdiğin gibi."
msgstr "Soupe de légumes, comme tu l'aimes."

#: scripts/babaanne_npc.gd:154
msgid "Afiyet olsun canım, kuvvet olsun!"
msgstr "Bon appétit, mon chéri, et deviens fort !"

#: scripts/babaanne_npc.gd:154
msgid "Yanına taze ekmek de koydum."
msgstr "J'ai aussi mis du pain frais à côté."

#: scripts/babaanne_npc.gd:155
msgid "Üfle üfle, dilini yakma!"
msgstr "Souffle dessus, ne te brûle pas la langue !"

#: scripts/babaanne_npc.gd:155
msgid "Annemin tarifi, her derde iyi gelir."
msgstr "La recette de ma mère, bonne pour tous les maux."

#: scripts/babaanne_npc.gd:158
msgid "Gençken ben de senin gibi maceracıydım."
msgstr "Jeune, j'étais une aventurière, tout comme toi."

#: scripts/babaanne_npc.gd:158
msgid "Deden de hiç yerinde durmazdı, sen ona çekmişsin."
msgstr "Ton grand-père ne tenait jamais en place non plus, tu tiens de lui."

#: scripts/babaanne_npc.gd:159
msgid "Kazan kaynıyor, birazdan çorba hazır."
msgstr "La marmite bout, la soupe sera bientôt prête."

#: scripts/babaanne_npc.gd:159
msgid "Dışarıda dolaşırken atkını unutma!"
msgstr "N'oublie pas ton écharpe quand tu sors !"

#: scripts/babaanne_npc.gd:159
msgid "Bu kemiklerim yağmuru hep önceden bilir."
msgstr "Mes vieux os savent toujours quand la pluie arrive."

#: scripts/babaanne_npc.gd:160
msgid "Sen sağlıklı ol yeter, gerisi kolay."
msgstr "Tant qu'on a la santé, le reste est facile."

#: scripts/babaanne_npc.gd:160
msgid "Akşama erken gel, ateşi yakarım."
msgstr "Rentre tôt ce soir, j'allumerai le feu."

#: scripts/babaanne_npc.gd:160
msgid "Rafların tozunu aldım, bak nasıl parlıyor!"
msgstr "J'ai dépoussiéré les étagères, regarde comme elles brillent !"

#: scripts/babaanne_npc.gd:161
msgid "Bahçedeki çiçekler bu yıl çok güzel açtı."
msgstr "Les fleurs du jardin sont magnifiques cette année."

#: scripts/babaanne_npc.gd:161
msgid "Kitabımın sonunu merak ediyorum, sakın söyleme!"
msgstr "Je meurs d'envie de savoir comment finit mon livre, ne t'avise pas de me le dire !"

#: scripts/babaanne_npc.gd:162
msgid "Bir gün sana örgü örmeyi öğreteceğim."
msgstr "Un jour je t'apprendrai à tricoter."

#: scripts/babaanne_npc.gd:162
msgid "Şu sandalye de benim dizlerim gibi gıcırdıyor."
msgstr "Cette chaise grince comme mes genoux."

#: scripts/babaanne_npc.gd:163
msgid "Elmalı turta yapmayı düşünüyorum, ne dersin?"
msgstr "Je pense faire une tarte aux pommes, qu'en dis-tu ?"

#: scripts/babaanne_npc.gd:163
msgid "Pencereden kuşları izlemek en sevdiğim şey."
msgstr "Regarder les oiseaux par la fenêtre, c'est ce que je préfère."

#: scripts/babaanne_npc.gd:166
msgid "Aman tatlım, ne bu hâlin? Otur biraz dinlen."
msgstr "Oh mon chou, regarde-toi ! Assieds-toi et repose-toi un peu."

#: scripts/babaanne_npc.gd:166
msgid "Yaralanmışsın! Gel, bir çorba içmeden çıkma."
msgstr "Tu es blessé ! Viens, ne pars pas sans un bol de soupe."

#: scripts/babaanne_npc.gd:167
msgid "Dizlerin titriyor, bir dakika otur."
msgstr "Tes genoux tremblent, assieds-toi une minute."

#: scripts/babaanne_npc.gd:167
msgid "Bu kesik kötü görünüyor, hemen sarayım."
msgstr "Cette coupure a l'air vilaine, laisse-moi la bander tout de suite."

#: scripts/babaanne_npc.gd:170
msgid "Gece dışarısı tehlikeli, şöminenin yanında otur."
msgstr "Dehors, la nuit, c'est dangereux, assieds-toi près de la cheminée."

#: scripts/babaanne_npc.gd:170
msgid "Yaratıklar gece azar, dikkat et canım."
msgstr "Les créatures deviennent féroces la nuit, sois prudent, mon chéri."

#: scripts/babaanne_npc.gd:171
msgid "Yıldızlar ne güzel bu gece, ama sen yine de içeride kal."
msgstr "Les étoiles sont belles ce soir, mais tu ferais mieux de rester à l'intérieur."

#: scripts/babaanne_npc.gd:175
msgid "Hı hı hı! Sen de amma şakacısın!"
msgstr "Hi hi hi ! Quel farceur !"

#: scripts/babaanne_npc.gd:175
msgid "Hmm... bir şey unuttum ama neydi?"
msgstr "Hmm... j'ai oublié quelque chose, mais quoi ?"

#: scripts/babaanne_npc.gd:176
msgid "Ben ne bileyim tatlım, ben yaşlı bir kadınım."
msgstr "Comment le saurais-je, mon chou ? Je suis une vieille femme."

#: scripts/babaanne_npc.gd:176
msgid "Seni görmek ne güzel!"
msgstr "Ça me fait tellement plaisir de te voir !"

#: scripts/babaanne_npc.gd:177
msgid "Gençken dansta herkesi geçerdim, hı hı!"
msgstr "Jeune, je dansais mieux que tout le monde, hi hi !"

#: scripts/babaanne_npc.gd:177
msgid "Gözlüğüm nerede... ah, burnumun ucunda!"
msgstr "Où sont mes lunettes... ah, sur le bout de mon nez !"

#: scripts/babaanne_npc.gd:180
msgid "Zzz..."
msgstr "Zzz..."

#: scripts/babaanne_npc.gd:180
msgid "Hıımm... beş dakika daha..."
msgstr "Hmmm... encore cinq minutes..."

#: scripts/babaanne_npc.gd:180
msgid "Uyandırdın beni... iyi geceler tatlım."
msgstr "Tu m'as réveillée... bonne nuit, mon chou."

#: scripts/babaanne_npc.gd:180
msgid "Zzz... çorba... Zzz..."
msgstr "Zzz... soupe... Zzz..."

#: scripts/babaanne_npc.gd:181
msgid "Mmm... kurabiyeler fırında... Zzz..."
msgstr "Mmm... des biscuits au four... Zzz..."

#: scripts/babaanne_npc.gd:181
msgid "Zzz... kim o... ah, sensin..."
msgstr "Zzz... qui est là... ah, c'est toi..."

#: scripts/babaanne_npc.gd:184
msgid "Daha az önce yedin, birazdan yine pişiririm."
msgstr "Tu viens de manger, je recuisinerai tout à l'heure."

#: scripts/babaanne_npc.gd:184
msgid "Karnın tok mu? Peki, akşama yine yaparım."
msgstr "Déjà rassasié ? D'accord, j'en referai ce soir."

#: scripts/babaanne_npc.gd:185
msgid "Bu kadar çabuk acıktın mı? Biraz bekle, kazan doluyor."
msgstr "Déjà faim ? Attends un peu, la marmite se remplit."

#: scripts/babaanne_npc.gd:188
msgid "Kendine iyi bak tatlım!"
msgstr "Prends soin de toi, mon chou !"

#: scripts/babaanne_npc.gd:188
msgid "Akşama gel, çorba hazır olur!"
msgstr "Passe ce soir, la soupe sera prête !"

#: scripts/babaanne_npc.gd:188
msgid "Hava kararmadan dön!"
msgstr "Rentre avant la nuit !"

#: scripts/babaanne_npc.gd:188
msgid "Yolun açık olsun canım!"
msgstr "Bon voyage, mon chéri !"

#: scripts/babaanne_npc.gd:189
msgid "Atkını unutma!"
msgstr "N'oublie pas ton écharpe !"

#: scripts/babaanne_npc.gd:189
msgid "Erken dön, merak ederim."
msgstr "Rentre tôt, sinon je m'inquiète."

#: scripts/babaanne_npc.gd:192
msgid "Biraz daha tuz mu koysam?"
msgstr "Je rajoute un peu de sel ?"

#: scripts/babaanne_npc.gd:192
msgid "Mmm, tam kıvamında!"
msgstr "Mmm, parfait !"

#: scripts/babaanne_npc.gd:192
msgid "Kokusu her yeri sardı!"
msgstr "L'odeur est partout !"

#: scripts/babaanne_npc.gd:192
msgid "Bir tutam kekik iyi gider..."
msgstr "Une pincée de thym serait bien..."

#: scripts/babaanne_npc.gd:193
msgid "Kaynasın bakalım, acele yok."
msgstr "Laissons mijoter, rien ne presse."

#: scripts/babaanne_npc.gd:193
msgid "Şu havuçlar da ne iri olmuş!"
msgstr "Regarde comme ces carottes ont poussé !"

#: scripts/babaanne_npc.gd:195
msgid "Şu tozlar da hiç bitmez!"
msgstr "Cette poussière ne finit jamais !"

#: scripts/babaanne_npc.gd:195
msgid "Her yer pırıl pırıl olsun."
msgstr "Tout est propre et étincelant."

#: scripts/babaanne_npc.gd:195
msgid "Örümcek, burası senin evin değil!"
msgstr "Araignée, ce n'est pas ta maison !"

#: scripts/babaanne_npc.gd:196
msgid "Bir de raflara bakalım..."
msgstr "Voyons aussi les étagères..."

#: scripts/babaanne_npc.gd:197
msgid "Ne güzel kitap bu..."
msgstr "Quel joli livre..."

#: scripts/babaanne_npc.gd:197
msgid "Hmm, bu kısmı okumuştum galiba."
msgstr "Hmm, je crois que j'ai déjà lu ce passage."

#: scripts/babaanne_npc.gd:197
msgid "Ah, sonunda kavuştular!"
msgstr "Ah, enfin réunis !"

#: scripts/babaanne_npc.gd:198
msgid "Gözlüğümü silmem lazım..."
msgstr "Il faut que je nettoie mes lunettes..."

#: scripts/babaanne_npc.gd:202
msgid "Şükürler olsun, sağsın!"
msgstr "Dieu merci, tu es vivant !"

#: scripts/babaanne_npc.gd:202
msgid "Geldin mi canım? Dışarısı savaş alanı..."
msgstr "Tu es revenu, mon chéri ? C'est un champ de bataille dehors..."

#: scripts/babaanne_npc.gd:202
msgid "Çabuk içeri, kapıyı ört! Canavarlar çok yakın."
msgstr "Vite, entre et ferme la porte ! Les monstres sont tout près."

#: scripts/babaanne_npc.gd:203
msgid "Yüzün gözün toz içinde! Kaç canavar devirdin?"
msgstr "Tu es couvert de poussière ! Combien de monstres as-tu abattus ?"

#: scripts/babaanne_npc.gd:203
msgid "Seni bekliyordum, yüreğim ağzımdaydı!"
msgstr "Je t'attendais, j'avais le cœur au bord des lèvres !"

#: scripts/babaanne_npc.gd:203
msgid "Yaralandın mı? Göster bakayım!"
msgstr "Tu es blessé ? Fais voir !"

#: scripts/babaanne_npc.gd:204
msgid "Sesleri duydum, çok korktum senin için."
msgstr "J'ai entendu les bruits, j'ai eu si peur pour toi."

#: scripts/babaanne_npc.gd:204
msgid "Gel, biraz soluklan. Ama çok oyalanma!"
msgstr "Viens, reprends ton souffle. Mais ne traîne pas !"

#: scripts/babaanne_npc.gd:204
msgid "Kahramanım geldi! Dışarısı nasıl?"
msgstr "Mon héros est de retour ! Comment ça se passe dehors ?"

#: scripts/babaanne_npc.gd:205
msgid "Kapıyı sıkıca kapat, kokumuzu almasınlar."
msgstr "Ferme bien la porte pour qu'ils ne sentent pas notre odeur."

#: scripts/babaanne_npc.gd:208
msgid "Şükürler olsun, hepiniz sağsınız!"
msgstr "Dieu merci, vous êtes tous vivants !"

#: scripts/babaanne_npc.gd:208
msgid "Geldiniz mi çocuklar? Dışarısı savaş alanı..."
msgstr "Vous êtes revenus, les enfants ? C'est un champ de bataille dehors..."

#: scripts/babaanne_npc.gd:208
msgid "Çabuk içeri, kapıyı örtün! Canavarlar çok yakın."
msgstr "Vite, entrez et fermez la porte ! Les monstres sont tout près."

#: scripts/babaanne_npc.gd:209
msgid "Yüzünüz gözünüz toz içinde! Kaç canavar devirdiniz?"
msgstr "Vous êtes tous couverts de poussière ! Combien de monstres avez-vous abattus ?"

#: scripts/babaanne_npc.gd:209
msgid "Sizi bekliyordum, yüreğim ağzımdaydı!"
msgstr "Je vous attendais, j'avais le cœur au bord des lèvres !"

#: scripts/babaanne_npc.gd:209
msgid "Yaralanan var mı? Gösterin bakayım!"
msgstr "Quelqu'un est blessé ? Faites voir !"

#: scripts/babaanne_npc.gd:210
msgid "Sesleri duydum, hepiniz için çok korktum."
msgstr "J'ai entendu les bruits, j'ai eu si peur pour vous tous."

#: scripts/babaanne_npc.gd:210
msgid "Gelin, biraz soluklanın. Ama çok oyalanmayın!"
msgstr "Venez, reprenez votre souffle. Mais ne traînez pas !"

#: scripts/babaanne_npc.gd:210
msgid "Kahramanlarım geldi! Dışarısı nasıl?"
msgstr "Mes héros sont de retour ! Comment ça se passe dehors ?"

#: scripts/babaanne_npc.gd:211
msgid "Kapıyı sıkıca kapatın, kokumuzu almasınlar."
msgstr "Fermez bien la porte pour qu'ils ne sentent pas notre odeur."

#: scripts/babaanne_npc.gd:214
msgid "Şansınız bol olsun çocuklar!"
msgstr "Bonne chance, les enfants !"

#: scripts/babaanne_npc.gd:214
msgid "Sağ salim dönün, söz verin bana!"
msgstr "Revenez sains et saufs, promettez-le-moi !"

#: scripts/babaanne_npc.gd:214
msgid "Gösterin onlara gününü!"
msgstr "Montrez-leur de quoi vous êtes capables !"

#: scripts/babaanne_npc.gd:214
msgid "Dikkat edin, birbirinizin arkasını kollayın!"
msgstr "Soyez prudents, protégez-vous les uns les autres !"

#: scripts/babaanne_npc.gd:215
msgid "Cesur olun ama dikkatsiz olmayın!"
msgstr "Soyez courageux, mais pas imprudents !"

#: scripts/babaanne_npc.gd:215
msgid "Ateşi yanık tutacağım, dönün bana!"
msgstr "Je garderai le feu allumé, revenez-moi !"

#: scripts/babaanne_npc.gd:218
msgid "Al şu çorbayı, savaşta güç lazım!"
msgstr "Prenez cette soupe, vous aurez besoin de force dehors !"

#: scripts/babaanne_npc.gd:218
msgid "Ye ki o canavarlara gününü göster!"
msgstr "Mangez, puis montrez à ces monstres de quoi vous êtes capables !"

#: scripts/babaanne_npc.gd:218
msgid "Sıcak sıcak iç, yaraların çabuk kapansın."
msgstr "Buvez-la bien chaude, vos blessures guériront plus vite."

#: scripts/babaanne_npc.gd:219
msgid "Aç karnına savaşılmaz, ye hadi!"
msgstr "On ne se bat pas le ventre vide, mangez !"

#: scripts/babaanne_npc.gd:219
msgid "Bu çorba ölüyü diriltir, iç bakalım!"
msgstr "Cette soupe ressusciterait un mort, buvez !"

#: scripts/babaanne_npc.gd:222
msgid "Bu canavarlar da nereden çıktı böyle, anlamadım gitti."
msgstr "D'où sortent tous ces monstres ? Je ne comprends pas."

#: scripts/babaanne_npc.gd:222
msgid "Deden de bir zamanlar bu adayı savunmuştu."
msgstr "Ton grand-père a lui aussi défendu cette île autrefois."

#: scripts/babaanne_npc.gd:223
msgid "Evde fazla oyalanma, canavarlar kokumuzu alır."
msgstr "Ne traînez pas à la maison, les monstres vont sentir notre odeur."

#: scripts/babaanne_npc.gd:223
msgid "Sen savaş, ben çorbayı sıcak tutarım."
msgstr "Vous, battez-vous ; moi, je garde la soupe au chaud."

#: scripts/babaanne_npc.gd:224
msgid "Ben savaşamam ama kalbim hep seninle."
msgstr "Je ne peux pas me battre, mais mon cœur est toujours avec vous."

#: scripts/babaanne_npc.gd:224
msgid "Kıyıdan gelen o sesler... bu gece uyku yok bana."
msgstr "Ces bruits venant du rivage... pas de sommeil pour moi cette nuit."

#: scripts/babaanne_npc.gd:225
msgid "Gücün tükenirse buraya gel, ama uzun kalma!"
msgstr "Venez si vous êtes épuisés, mais ne restez pas longtemps !"

#: scripts/babaanne_npc.gd:225
msgid "Bu ada bizim, kimseye bırakmayız!"
msgstr "Cette île est à nous, nous ne la céderons pas !"

#: scripts/babaanne_npc.gd:226
msgid "Duvarlar yaşlı ama sağlamdır, yine de güvenme."
msgstr "Les murs sont vieux mais solides ; ne comptez pas dessus pour autant."

#: scripts/babaanne_npc.gd:226
msgid "Yaralarını sarmak için temiz bez ayırdım."
msgstr "J'ai mis de côté des linges propres pour bander vos blessures."

#: scripts/babaanne_npc.gd:227
msgid "Gece boyu ateşi söndürmeyeceğim, yolunu bulasın diye."
msgstr "Je garderai le feu allumé toute la nuit pour que vous trouviez votre chemin."

#: scripts/babaanne_npc.gd:227
msgid "Korkmak ayıp değil, korkuya rağmen yürümek cesarettir."
msgstr "Avoir peur n'est pas une honte ; avancer malgré elle, c'est du courage."

#: scripts/babaanne_npc.gd:228
msgid "Biri kapıya vurursa önce sesine bakarım, merak etme."
msgstr "Si quelqu'un frappe, je vérifierai d'abord la voix, ne vous inquiétez pas."

#: scripts/babaanne_npc.gd:228
msgid "Canavarların gözleri karanlıkta parlıyormuş, dikkat et."
msgstr "On dit que les yeux des monstres brillent dans le noir, prudence."

#: scripts/babaanne_npc.gd:231
msgid "Gece canavarlar daha da azar, gözünü dört aç."
msgstr "La nuit, les monstres sont plus féroces, ouvrez l'œil."

#: scripts/babaanne_npc.gd:231
msgid "Karanlıkta yalnız dolaşma, yanında biri olsun."
msgstr "Ne vous promenez pas seuls dans le noir, emmenez quelqu'un."

#: scripts/babaanne_npc.gd:232
msgid "Fenerini al, karanlık onların tarafında."
msgstr "Prenez votre lanterne, l'obscurité est de leur côté."

#: scripts/babaanne_npc.gd:235
msgid "Ben gençken bir ayıyı tavayla kovaladım, hı hı!"
msgstr "Jeune, j'ai chassé un ours avec une poêle, hi hi !"

#: scripts/babaanne_npc.gd:235
msgid "Hmm... canavarlar acaba çorba sever mi?"
msgstr "Hmm... je me demande si les monstres aiment la soupe ?"

#: scripts/babaanne_npc.gd:236
msgid "Ne yapayım, ben yaşlı bir kadınım."
msgstr "Que veux-tu que je fasse, je suis une vieille femme."

#: scripts/babaanne_npc.gd:236
msgid "Sağ salim döndün ya, gerisi boş!"
msgstr "Tu es revenu sain et sauf, c'est tout ce qui compte !"

#: scripts/babaanne_npc.gd:237
msgid "Bir canavar daha görürsem şemsiyemle döverim, hı hı!"
msgstr "Si je vois encore un monstre, je le frappe avec mon parapluie, hi hi !"

#: scripts/babaanne_npc.gd:237
msgid "Kaç taneydiler? Saymayı unuttum..."
msgstr "Ils étaient combien ? J'ai perdu le compte..."

#: scripts/babaanne_npc.gd:240
msgid "Şansın bol olsun canım!"
msgstr "Bonne chance, mon chéri !"

#: scripts/babaanne_npc.gd:240
msgid "Sağ salim dön, söz ver bana!"
msgstr "Reviens sain et sauf, promets-le-moi !"

#: scripts/babaanne_npc.gd:240
msgid "Göster onlara gününü!"
msgstr "Montre-leur de quoi tu es capable !"

#: scripts/babaanne_npc.gd:240
msgid "Dikkat et, arkanı kolla!"
msgstr "Sois prudent, surveille tes arrières !"

#: scripts/babaanne_npc.gd:241
msgid "Cesur ol ama dikkatsiz olma!"
msgstr "Sois courageux, mais pas imprudent !"

#: scripts/babaanne_npc.gd:241
msgid "Ateşi yanık tutacağım, dön bana!"
msgstr "Je garderai le feu allumé, reviens-moi !"

#: scripts/babaanne_npc.gd:244
msgid "Savaşanlara sıcak çorba lazım..."
msgstr "Les combattants ont besoin de soupe chaude..."

#: scripts/babaanne_npc.gd:244
msgid "Elim titriyor ama çorba yanmasın."
msgstr "Mes mains tremblent, mais la soupe ne doit pas brûler."

#: scripts/babaanne_npc.gd:244
msgid "Kepçeyi sıkı tut, korkma!"
msgstr "Tiens bien la louche, n'aie pas peur !"

#: scripts/babaanne_npc.gd:245
msgid "Kazan dolu olsun, kim gelirse doysun."
msgstr "Que la marmite reste pleine, pour que chacun puisse manger."

#: scripts/babaanne_npc.gd:245
msgid "Aç kalan kahraman olmaz..."
msgstr "Aucun héros n'a jamais gagné le ventre vide..."

#: scripts/babaanne_npc.gd:249
msgid "Duyuyor musun? Duvarlara vuruyorlar!"
msgstr "Tu entends ça ? Ils cognent sur les murs !"

#: scripts/babaanne_npc.gd:249
msgid "Bu ev çok dayanmaz, çık savaş!"
msgstr "Cette maison ne tiendra pas longtemps, sors te battre !"

#: scripts/babaanne_npc.gd:249
msgid "Aman tavan! Tavan çöküyor!"
msgstr "Le plafond ! Le plafond s'effondre !"

#: scripts/babaanne_npc.gd:250
msgid "Canavarlar kapıya dayandı!"
msgstr "Les monstres sont à la porte !"

#: scripts/babaanne_npc.gd:250
msgid "Burada saklanarak kurtulamayız tatlım!"
msgstr "On ne survivra pas en se cachant ici, mon chou !"

#: scripts/babaanne_npc.gd:250
msgid "Duvarlar çatlıyor, aman Tanrım!"
msgstr "Les murs se fissurent, mon Dieu !"

#: scripts/babaanne_npc.gd:251
msgid "Kapı daha ne kadar dayanır bilmiyorum!"
msgstr "Je ne sais pas combien de temps la porte tiendra encore !"

#: scripts/babaanne_npc.gd:251
msgid "Çık şunları kovala, yoksa içeri girecekler!"
msgstr "Allez les chasser, sinon ils vont entrer !"

#: scripts/babaanne_npc.gd:252
msgid "Tozlar başıma yağıyor... çabuk ol!"
msgstr "Il me pleut de la poussière sur la tête... vite !"

#: scripts/babaanne_npc.gd:252
msgid "Bu evi dedenle birlikte yaptık, yıkılmasın!"
msgstr "Ton grand-père et moi avons construit cette maison, ne la laisse pas tomber !"

#: scripts/babaanne_npc.gd:254
msgid "Aman Tanrım! Deprem mi bu?!"
msgstr "Mon Dieu ! C'est un tremblement de terre ?!"

#: scripts/babaanne_npc.gd:254
msgid "Yer sallanıyor! Bir yere tutunun!"
msgstr "Le sol tremble ! Accrochez-vous à quelque chose !"

#: scripts/babaanne_npc.gd:254
msgid "Bu ses de ne?! Herkes iyi mi?"
msgstr "C'était quoi ce bruit ?! Tout le monde va bien ?"

#: scripts/babaanne_npc.gd:256
msgid "Canavarlar! Adaya canavarlar saldırıyor!"
msgstr "Des monstres ! Des monstres attaquent l'île !"

#: scripts/babaanne_npc.gd:256
msgid "Kıyıda gölgeler var... canavarlar geliyor!"
msgstr "Il y a des ombres sur le rivage... des monstres arrivent !"

#: scripts/babaanne_npc.gd:256
msgid "Aman Tanrım, sahil canavar dolu!"
msgstr "Mon Dieu, le rivage est plein de monstres !"

#: scripts/babaanne_npc.gd:259
msgid "Hadi çocuklar, çıkın savaşın! Ben evi beklerim."
msgstr "Allez, les enfants, dehors et battez-vous ! Je garde la maison."

#: scripts/babaanne_npc.gd:259
msgid "Silahlarınızı alın, adamızı koruyun!"
msgstr "Prenez vos armes, défendez notre île !"

#: scripts/babaanne_npc.gd:260
msgid "Gidin hadi! Ben burada ateşi yanık tutarım."
msgstr "Allez ! Je garde le feu allumé ici."

#: scripts/babaanne_npc.gd:263
msgid "Evim... yıkıldı mı yoksa?"
msgstr "Ma maison... elle n'est plus ?"

#: scripts/babaanne_npc.gd:263
msgid "Ben savaşamam, yanımdan ayrılmayın!"
msgstr "Je ne peux pas me battre, ne me quitte pas !"

#: scripts/babaanne_npc.gd:263
msgid "Şu canavarlar evimi yerle bir etti!"
msgstr "Ces monstres ont démoli ma maison !"

#: scripts/babaanne_npc.gd:264
msgid "Duvarlar onarılana kadar burada beklerim."
msgstr "J'attendrai ici que les murs soient réparés."

#: scripts/babaanne_npc.gd:264
msgid "Bu yaşta kapı önünde kaldım, ne günlere kaldık!"
msgstr "À la porte de chez moi à mon âge, quelle époque !"

#: scripts/babaanne_npc.gd:264
msgid "Elimde süpürge bile yok..."
msgstr "Je n'ai même pas de balai..."

#: scripts/babaanne_npc.gd:266
msgid "İmdat! Çocuklar, yetişin!"
msgstr "À l'aide ! Les enfants, vite !"

#: scripts/babaanne_npc.gd:266
msgid "Uzak dur benden, yaratık!"
msgstr "Éloigne-toi de moi, sale bête !"

#: scripts/babaanne_npc.gd:266
msgid "Yardım edin!"
msgstr "À l'aide !"

#: scripts/babaanne_npc.gd:266
msgid "Kurtarın beni!"
msgstr "Sauvez-moi !"

#: scripts/babaanne_npc.gd:267
msgid "Hayır, hayır, gelme!"
msgstr "Non, non, éloigne-toi !"

#: scripts/babaanne_npc.gd:268
msgid "Ahh!"
msgstr "Ahh!"

#: scripts/babaanne_npc.gd:268
msgid "Aman!"
msgstr "Oh là là !"

#: scripts/babaanne_npc.gd:268
msgid "Of belim!"
msgstr "Oh, mon dos !"

#: scripts/babaanne_npc.gd:268
msgid "Ay!"
msgstr "Aïe !"

#: scripts/babaanne_npc.gd:268
msgid "Acıyor!"
msgstr "Aïe, ça fait mal !"

#: scripts/babaanne_npc.gd:269
msgid "Of... nefesim kesildi!"
msgstr "Oh... je suis à bout de souffle !"

#: scripts/babaanne_npc.gd:269
msgid "Bu yaşta koşulur mu..."
msgstr "Courir à mon âge..."

#: scripts/babaanne_npc.gd:269
msgid "Dizlerim... az dur!"
msgstr "Mes genoux... tenez bon !"

#: scripts/babaanne_npc.gd:269
msgid "Biraz... soluklanayım..."
msgstr "Laissez-moi... reprendre mon souffle..."

#: scripts/babaanne_npc.gd:270
msgid "Ah... çocuklarım..."
msgstr "Oh... mes enfants..."

#: scripts/babaanne_npc.gd:270
msgid "Ateşi... yanık tutun..."
msgstr "Gardez... le feu... allumé..."

#: scripts/babaanne_npc.gd:271
msgid "Evime dönüyorum, çorbayı ısıtayım!"
msgstr "Je rentre réchauffer la soupe !"

#: scripts/babaanne_npc.gd:271
msgid "Ah evim, güzel evim!"
msgstr "Ah, rien ne vaut son chez-soi !"

#: scripts/babaanne_npc.gd:271
msgid "Duvarlar sağlam mı? Bir bakayım."
msgstr "Les murs tiennent-ils ? Je vais vérifier."

