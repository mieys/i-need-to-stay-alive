[sub_resource type="Shader" id="Shader_o6xl0"]
code = "shader_type canvas_item;

uniform vec4 dirt_color : source_color = vec4(0.25, 0.20, 0.15, 1.0);
uniform float dirt_opacity : hint_range(0.0, 1.0) = 0.35;
uniform float dirt_scale : hint_range(0.0001, 0.05) = 0.005; // Dünya koordinatları için ölçek küçüldü!
uniform float noise_threshold : hint_range(0.0, 1.0) = 0.4;

// Varying ile Dünya koordinatını fragment aşamasına taşıyoruz
varying vec2 world_position;

void vertex() {
    // Model koordinatını dünya koordinatına çevir (TileMap position)
    world_position = (MODEL_MATRIX * vec4(VERTEX, 0.0, 1.0)).xy;
}

float hash(vec2 p) {
    p = fract(p * vec2(123.34, 456.21));
    p += dot(p, p + 45.32);
    return fract(p.x * p.y);
}

float value_noise(vec2 st) {
    vec2 i = floor(st);
    vec2 f = fract(st);

    float a = hash(i);
    float b = hash(i + vec2(1.0, 0.0));
    float c = hash(i + vec2(0.0, 1.0));
    float d = hash(i + vec2(1.0, 1.0));

    vec2 u = f * f * (3.0 - 2.0 * f);
    return mix(a, b, u.x) + (c - a) * u.y * (1.0 - u.x) + (d - b) * u.x * u.y;
}

// 4 Katmanlı FBM (Daha detaylı ve organik rastgelelik)
float fbm(vec2 st) {
    float value = 0.0;
    float amplitude = 0.5;
    for (int i = 0; i < 4; i++) {
        value += amplitude * value_noise(st);
        st *= 2.0;
        amplitude *= 0.5;
    }
    return value;
}

void fragment() {
    vec4 texture_color = texture(TEXTURE, UV);

    // UV yerine dünya koordinatlarını (world_position) kullanıyoruz!
    vec2 dirt_uv = world_position * dirt_scale;
    float noise_val = fbm(dirt_uv);

    float dirt_mask = smoothstep(noise_threshold, noise_threshold + 0.3, noise_val);
    vec3 final_rgb = mix(texture_color.rgb, dirt_color.rgb, dirt_mask * dirt_opacity);

    COLOR = vec4(final_rgb, texture_color.a);
}"

