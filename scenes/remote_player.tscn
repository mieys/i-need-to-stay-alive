[node name="RemotePlayer" type="CharacterBody2D" groups=["player_ally"]]
scale = Vector2(0.5, 0.5)
## DÜZELTME (kullanıcı bildirimi: "menzilli hasar veren düşmanlar sadece
## hosta hasar verebiliyor katılımcılara hasar veremiyorlar") - kök neden:
## host'un GERÇEK Player'ı main.tscn'de instance-override ile collision_
## layer=2'ye taşınmıştı (bkz. scenes/main.tscn Player node'u), yani "layer
## 2" projede tutarlı bir "bu bir oyuncu" katmanı - enemy_projectile.tscn
## (mermi, mask=2), TÜM toplama eşyaları (xp_orb/gold_drop/food_drop/
## chest_drop/magnet_drop, hepsi mask=2) ve düşmanların kendi HitArea'sı
## (mask=2) hep bunu arıyor. Bu sahne (RemotePlayer - katılımcıların host
## ekranındaki kuklası) hâlâ eski/kullanılmayan layer=1'deydi - hiçbir
## sistemin maskesi 1'i içermediği için host'un ekranındaki menzilli
## mermiler bir katılımcının kuklasının TAM İÇİNDEN geçip gidiyor,
## body_entered hiç tetiklenmiyordu (hasar zaten doğru şekilde RemotePlayer.
## take_damage() -> NetworkManager.forward_damage_to_peer ile o oyuncuya
## yönlendiriliyordu, ama bu fonksiyon hiç ÇAĞRILMIYORDU çünkü çarpışma
## algılanmıyordu). Artık gerçek Player ile AYNI layer=2.
collision_layer = 2
collision_mask = 0
script = ExtResource("1_remote")

